generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. K-Destiny 독자적 사주 해석 콘텐츠 딕셔너리 (우리의 지적 재산 IP)
model SajuContentDictionary {
  id             String   @id @default(uuid())
  category       String
  signKey        String
  englishContent String   @db.Text
  remedyAction   String?  @db.Text
  updatedAt      DateTime @updatedAt

  @@unique([category, signKey])
}

// 2. 유저 명식 데이터베이스 (재계산 방지 및 PII 보호 구역)
model UserSajuProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthHash     String?
  gender        String
  fourPillars   Json
  dayMaster     String
  elementsScore Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  // 원본 입력 데이터 (화면 표시용, 기기 간 동기화)
  name        String?
  birthYear   String?
  birthMonth  String?
  birthDay    String?
  birthTime   String?
  unknownTime Boolean @default(false)
  country     String?
  city        String?

  // 담당 마스터 선택 (기기 간 동기화)
  selectedMasterId Int?
}

// 3. 사용자 및 권한 관리
enum Role {
  USER
  ADMIN
}

enum SubscriptionTier {
  FREE
  PREMIUM
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?

  role        Role             @default(USER)
  tier        SubscriptionTier @default(FREE)
  usageTokens Int              @default(3)
  // Date (server day) the premium 20/day karma was last refilled. Lazily reset
  // on access — no cron needed. Null/older-than-today ⇒ refill to 20 on next use.
  karmaResetAt DateTime?

  // SaaS Subscription Management
  planType           String? // '1_MONTH', '3_MONTHS', '6_MONTHS', '1_YEAR'
  paidAmount         Int? // Amount paid in cents (e.g., 9900 = $99.00)
  premiumStartDate   DateTime?
  premiumEndDate     DateTime?
  subscriptionStatus String?   @default("NONE") // 'NONE', 'ACTIVE', 'EXPIRED', 'CANCELLED'

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles UserSajuProfile[]
  accounts Account[]
  sessions Session[]
  purchasedReports PurchasedReport[]
  pushSubscriptions PushSubscription[]
  orders          Order[]
  subscriptions   Subscription?
  weeklyFortunes  WeeklyFortune[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// 4. Hermes AI Agent — Telegram 연동 데이터
model TelegramAccount {
  id              String            @id @default(cuid())
  telegramId      String            @unique
  username        String?
  firstName       String?
  lastName        String?
  userId          String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  TelegramMessage TelegramMessage[]
}

model TelegramMessage {
  id                String          @id @default(cuid())
  telegramAccountId String
  direction         String
  telegramMessageId String?
  text              String?
  payload           Json?
  createdAt         DateTime        @default(now())
  TelegramAccount   TelegramAccount @relation(fields: [telegramAccountId], references: [id], onDelete: Cascade)
}

// 5. 개별 리포트 단건 구매 추적
model PurchasedReport {
  id        String   @id @default(cuid())
  userId    String
  reportId  String   // 어떤 리포트(사주 프로필)를 구매했는지
  gumroadId String?  // Gumroad sale_id
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 6. 오늘의 운세 캐시 (Day Master 그룹별, API 비용 절약)
model DailyFortune {
  id           String   @id @default(cuid())
  dayMasterKey String   // e.g., "WOOD_YANG"
  locale       String   // e.g., "ko", "en"
  date         String   // "YYYY-MM-DD"
  summary      String   @db.Text // 무료: 1줄 요약
  fullContent  String   @db.Text // 프리미엄: 전체 내용
  luckyColor   String?
  luckyNumber  String?
  luckyDir     String?
  createdAt    DateTime @default(now())

  @@unique([dayMasterKey, locale, date])
}

// 7. 콩닥 Phase A 궁합 모델
model Compatibility {
  id             String   @id @default(cuid())
  // 1. 입력 (비회원 허용)
  userId         String?
  personA        Json
  personB        Json
  relation       String   @default("love") // love | crush | friend
  
  // 2. 결과 (결정론)
  score          Int
  keywords       String[]
  breakdown      Json
  
  // 3. AI 해석 캐시
  summaryKo      String?  @db.Text
  premiumKo      String?  @db.Text
  isPaid         Boolean  @default(false)
  
  // 4. 바이럴 추적
  shareToken     String   @unique
  sourceCompatId String?
  createdAt      DateTime @default(now())
}

// 8. 웹 푸시 구독 정보 (PWA 마케팅용)
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?  // null 이면 비로그인(무료) 유저로 간주
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

// 9. 결제 주문 (건별/구독 통합)
enum OrderType {
  SINGLE
  SUBSCRIPTION
  PERIOD_PASS
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED
  FAILED
}

model Order {
  id             String      @id @default(cuid())
  orderId        String      @unique // 토스에 전달하는 고유 주문번호 (e.g. kd_ord_cuid)
  userId         String?
  email          String?     // 게스트 결제용
  compatId       String?     // 단건 결제 대상 궁합 ID
  type           OrderType   @default(SINGLE)
  planId         String?     // 기간권 종류 ('1_MONTH', '3_MONTHS', '6_MONTHS', '1_YEAR')
  amount         Int         // 결제 금액 (원 단위: 1900, 2900, 9900)
  status         OrderStatus @default(PENDING)
  provider       String      @default("toss")
  tossPaymentKey String?     // 토스 승인 후 발급 키
  claimToken          String?     @unique
  claimTokenExpiresAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  unlocks        Unlock[]

  @@index([userId])
  @@index([compatId])
}

// 10. 단건 궁합 언락 권한
model Unlock {
  id        String    @id @default(cuid())
  compatId  String
  orderId   String
  userId    String?
  email     String?
  expiresAt DateTime? // 열람 만료 시점 (단건: 생성시점 + 90일)
  createdAt DateTime  @default(now())

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // [SECURITY / H-2] compatId 단독 유니크였을 때는 같은 궁합을 두 번째로 결제한
  // 사람에게 Unlock 행이 아예 생성되지 않아(대금만 수령) 열람이 막혔다.
  // 공유 링크로 여러 명이 같은 compatId를 구매하는 것이 이 서비스의 기본 시나리오이므로
  // 주문 단위로 1행을 보장한다. 동일 주문의 중복 부여는 이 복합 유니크가 막는다.
  @@unique([compatId, orderId])
  @@index([compatId])
  @@index([userId])
}

// 11. 정기 구독 관리
enum SubStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  status           SubStatus @default(ACTIVE)
  billingKey       String    // 토스 자동결제 빌링키
  customerKey      String    // 토스 고객 식별 키
  currentPeriodEnd DateTime  // 현재 결제 주기 만료일
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 12. 심층 리포트 AI 생성 캐시 (구조화된 JSON)
model DeepReport {
  id             String   @id @default(cuid())
  compatId       String   @unique
  content        Json     // 구조화된 심층 리포트 JSON 데이터
  createdAt      DateTime @default(now())
}

// 13. 이번 주 종합 운세 (개인 및 커플)
model WeeklyFortune {
  id             String   @id @default(cuid())
  userId         String   // 운세를 요청한 주체
  targetCompatId String?  // 커플 운세일 경우 연결된 Compatibility ID (null이면 개인 운세)
  weekStartDate  String   // "YYYY-MM-DD" 포맷 (월요일 기준)
  content        Json     // 생성된 주간 운세 JSON
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStartDate, targetCompatId]) // 해당 주차에 동일 타겟으로 중복 생성 방지
}

// 14. 관리자 운영 감사 로그
model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String   // 'REFUND' | 'UNLOCK_GRANT' | 'UNLOCK_EXTEND' | 'ROLE_CHANGE'
  targetType  String   // 'ORDER' | 'UNLOCK' | 'USER'
  targetId    String
  detail      Json?
  createdAt   DateTime @default(now())

  @@index([adminUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

