# K-Destiny environment variables — SAFE TEMPLATE (no secrets).
# Copy to `.env.local` (gitignored) and fill in real values. Never commit real keys.
# Only NEXT_PUBLIC_* are exposed to the browser; everything else is SERVER-ONLY.

# ── Database (Supabase Postgres) — SERVER ONLY ──
# Contains the DB password. If this ever leaks, ROTATE the password in Supabase.
DATABASE_URL="postgresql://user:PASSWORD@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:PASSWORD@host:5432/postgres"

# ── AI (paid Gemini tier) — SERVER ONLY ──
GEMINI_API_KEY=""

# ── Auth (NextAuth: Google, Kakao, Naver) — SERVER ONLY ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# ── Payments (Gumroad) — SERVER ONLY ──
GUMROAD_SELLER_ID=""
GUMROAD_WEBHOOK_SECRET=""

# ── Rate limiting (Upstash Redis) — SERVER ONLY ──
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Hermes internal agent — SERVER ONLY ──
HERMES_SECRET=""

# ── Supabase client keys ──
NEXT_PUBLIC_SUPABASE_URL=""       # public (safe in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""  # public anon key (safe in browser; RLS-protected)
SUPABASE_SERVICE_ROLE_KEY=""      # ADMIN key — SERVER ONLY, bypasses RLS. Never expose.

# ── Analytics ──
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"      # public GA4 measurement id (e.g. G-XXXXXXXXXX)

# ── 콩닥 Phase A ──
# 생년월일 해시용 pepper — SERVER ONLY. 반드시 설정할 것.
# 미설정 시 birthHash 가 무염(unsalted) SHA-256 이 되어 생년월일 전수 대입으로 역산 가능하다.
# 생성 예: openssl rand -base64 32
BIRTH_HASH_PEPPER=""
NEXT_PUBLIC_SITE_URL="https://kongdak.kr"   # public. canonical/og:url/sitemap/robots + OG 절대 URL 기준값.
                                            # 빌드타임 인라인 — 서버 빌드용 .env 에 반드시 포함할 것.
NEXT_PUBLIC_KAKAO_JS_KEY=""                 # public. 카카오톡 공유용 JavaScript 키
